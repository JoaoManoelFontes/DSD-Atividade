{
  "name": "payments-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "dev": "tsx --env-file=.env watch src/server.ts",
    "start": "node --env-file=.env --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "amqplib": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
