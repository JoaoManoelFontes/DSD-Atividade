{
  "name": "modular-monolith",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:migrate": "tsx --env-file=.env src/database/migrate.ts",
    "dev": "tsx --env-file=.env watch src/server.ts",
    "start": "node --env-file=.env --enable-source-maps dist/server.js"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
